---
import { SITE_EMAIL, BOOKING_URL } from '../consts';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <p class="copy">© {year} JustinCredible Web</p>
        <p class="footer-note muted">
          Built by Justin McBroom · Serving Gentry & Northwest Arkansas
        </p>
      </div>
      <div class="footer-ctas">
        <a class="btn" href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book a call</a>
        <a class="btn btn-ghost" href={`mailto:${SITE_EMAIL}`}>Email Justin</a>
      </div>
    </div>
    <nav aria-label="Footer">
      <a href={withBase('services')}>Services</a>
      <a href={withBase('care-plans')}>Care Plans</a>
      <a href={withBase('how-it-works')}>How it works</a>
      <a href={withBase('about')}>About</a>
      <a href={withBase('faq')}>FAQ</a>
      <a href={withBase('contact')}>Contact</a>
      <a href={withBase('get-started')}>Get started</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    width: min(100% - 2rem, var(--max-width-wide));
    margin-inline: auto;
    padding-block: 1.5rem 2rem;
    display: grid;
    gap: 1rem;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .copy {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-note {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
