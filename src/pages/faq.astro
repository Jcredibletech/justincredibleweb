---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL } from '../consts';
import { withBase } from '../utils/paths';

const faqs = [
  {
    q: 'How long does a Launch Site take?',
    a: 'Usually 1–2 weeks after I have your logo, services list, and contact details. Online System projects run closer to 2–3 weeks.',
  },
  {
    q: 'Do you write the copy?',
    a: 'Yes — clear, local copy based on what you tell me. You’ll review and approve before launch.',
  },
  {
    q: 'Where does the site host?',
    a: 'GitHub Pages is the default (fast and free for many small sites). Other static hosts work too if you already have a preference.',
  },
  {
    q: 'Can I update the site myself?',
    a: 'Small text changes can go through a Care Plan. If you want a CMS later, we can scope that as a separate project.',
  },
  {
    q: 'What’s the difference between Automate Ops standalone and the add-on?',
    a: 'Standalone ($3,500) is automation without a full new site build. The $1,500 add-on attaches to Launch Site or Online System when you’re already building with me.',
  },
  {
    q: 'Are Care Plans required?',
    a: 'No — but they’re strongly recommended. Sites go stale without someone watching forms, links, and small content drift.',
  },
  {
    q: 'Do you invent testimonials or client logos?',
    a: 'No. What you see here is what you get — real packages, real process, no fake social proof.',
  },
  {
    q: 'How do payments work?',
    a: 'Scoped in the proposal before work starts. Discounts, refunds, and payment exceptions go through Justin directly.',
  },
];
---
<BaseLayout
  title="FAQ"
  description="Frequently asked questions about JustinCredible Web packages, timelines, hosting, and Care Plans."
>
  <header class="page-header">
    <p class="eyebrow">FAQ</p>
    <h1>Common questions</h1>
    <p>Short answers. If yours isn’t here, email or book a call.</p>
  </header>

  <div class="faq">
    {faqs.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>

  <section class="cta-band">
    <h2>Still deciding?</h2>
    <p>Start the intake — even a rough note helps me point you at the right package.</p>
    <div class="btn-row">
      <a class="btn" href={withBase('get-started')}>Get started</a>
      <a class="btn btn-ghost" href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book a call</a>
    </div>
  </section>
</BaseLayout>
