---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PACKAGES, BOOKING_URL } from '../consts';
import { withBase } from '../utils/paths';
---
<BaseLayout
  title="Services"
  description="Launch Site, Automate Ops, and Online System packages from JustinCredible Web — clear pricing for NW Arkansas businesses."
>
  <header class="page-header">
    <p class="eyebrow">Services</p>
    <h1>Packages with clear scope and pricing</h1>
    <p>Pick a starting point. We’ll confirm fit before any work begins — no surprise invoices.</p>
  </header>

  <div class="card-grid" style="gap: 1.5rem;">
    {PACKAGES.map((pkg) => (
      <article class:list={['pkg-card', { 'hero-pkg': pkg.hero }]} id={pkg.id}>
        {pkg.hero && <span class="tag">Recommended full package</span>}
        <h2>{pkg.name}</h2>
        <p class="pkg-price">{pkg.price}</p>
        {'priceNote' in pkg && pkg.priceNote && <p class="pkg-price-note">{pkg.priceNote}</p>}
        <p class="muted">{pkg.blurb}</p>
        <ul>
          {pkg.includes.map((item) => <li>{item}</li>)}
        </ul>
        <div class="card-actions btn-row">
          <a class="btn" href={withBase(`get-started?package=${pkg.id}`)}>Get started</a>
          <a class="btn btn-ghost" href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book a call</a>
        </div>
      </article>
    ))}
  </div>

  <section class="cta-band">
    <h2>Not sure which fits?</h2>
    <p>Most local service businesses start with Launch Site or Online System, then add a Care Plan at launch.</p>
    <div class="btn-row">
      <a class="btn" href={withBase('how-it-works')}>See how it works</a>
      <a class="btn btn-ghost" href={withBase('care-plans')}>Care Plans</a>
    </div>
  </section>
</BaseLayout>
