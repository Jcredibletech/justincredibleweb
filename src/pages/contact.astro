---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, SITE_EMAIL, SITE_PHONE, SITE_AREA } from '../consts';
import { withBase } from '../utils/paths';
---
<BaseLayout
  title="Contact"
  description="Contact JustinCredible Web — email mustangeverything@gmail.com or book a call. Serving Gentry / Northwest Arkansas."
>
  <header class="page-header">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p>Prefer email or a booked call. Phone is secondary — use it when you need Justin directly.</p>
  </header>

  <ul class="contact-list">
    <li>
      <strong>Email (preferred)</strong>
      <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
    </li>
    <li>
      <strong>Book a call</strong>
      <a href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Open scheduling</a>
    </li>
    <li>
      <strong>Phone (secondary)</strong>
      <a href={`tel:+19709572495`}>{SITE_PHONE}</a>
      <span class="muted"> — when a live call with Justin is needed</span>
    </li>
    <li>
      <strong>Area</strong>
      <span>{SITE_AREA}</span>
    </li>
  </ul>

  <section class="cta-band" style="margin-top: 2rem;">
    <h2>Have a project in mind?</h2>
    <p>Use the intake form — it’s the fastest way to get a clear next step.</p>
    <div class="btn-row">
      <a class="btn" href={withBase('get-started')}>Get started</a>
      <a class="btn btn-ghost" href={`mailto:${SITE_EMAIL}`}>Email Justin</a>
    </div>
  </section>
</BaseLayout>
