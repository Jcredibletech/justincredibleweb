---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CARE_PLANS, BOOKING_URL } from '../consts';
import { withBase } from '../utils/paths';
---
<BaseLayout
  title="Care Plans"
  description="Monthly Care Plans from JustinCredible Web: Clean $250, Steady $350, Priority $500 — keep your site accurate and online."
>
  <header class="page-header">
    <p class="eyebrow">Retainers</p>
    <h1>Care Plans — stay online without DIY stress</h1>
    <p>
      Launch is day one. Care Plans are the quiet monthly work that keeps copy fresh,
      forms working, and small fixes from piling up.
    </p>
  </header>

  <div class="card-grid cols-3">
    {CARE_PLANS.map((plan) => (
      <article class="pkg-card" id={plan.id}>
        <h2>{plan.name}</h2>
        <p class="pkg-price">{plan.price}<span class="pkg-price-note"> {plan.period}</span></p>
        <p class="muted">{plan.blurb}</p>
        <ul>
          {plan.includes.map((item) => <li>{item}</li>)}
        </ul>
        <div class="card-actions">
          <a class="btn" href={withBase(`get-started?care=${plan.id}`)}>Choose {plan.name}</a>
        </div>
      </article>
    ))}
  </div>

  <section class="prose-block section-block" style="margin-top: 2rem;">
    <h2>How retainers work</h2>
    <p>
      Hours reset each month and don’t roll over. Unused time isn’t banked — the plan is for
      steady care, not a backlog dump. Bigger projects (redesigns, new automation) are scoped separately.
    </p>
    <p>
      Prefer to start with a build only? That’s fine. We’ll still recommend a Care Plan at launch
      so you’re not left holding a site with no maintenance plan.
    </p>
  </section>

  <section class="cta-band">
    <h2>Attach a Care Plan at launch</h2>
    <p>Best results come when retainer starts the same week the site goes live.</p>
    <div class="btn-row">
      <a class="btn" href={withBase('get-started')}>Start intake</a>
      <a class="btn btn-ghost" href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book a call</a>
    </div>
  </section>
</BaseLayout>
