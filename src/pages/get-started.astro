---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, SITE_EMAIL, PACKAGES, CARE_PLANS } from '../consts';

const mailto = `mailto:${SITE_EMAIL}?subject=${encodeURIComponent('JustinCredible Web — intake')}`;
---
<BaseLayout
  title="Get started"
  description="Start a JustinCredible Web project — short intake form for Launch Site, Automate Ops, Online System, or a Care Plan."
>
  <header class="page-header">
    <p class="eyebrow">Intake</p>
    <h1>Get started</h1>
    <p>
      Tell me a bit about your business. This form opens your email app with a pre-filled message
      (mailto fallback). Prefer a call?
      <a href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book one here</a>.
    </p>
  </header>

  <form class="form-grid" id="intake-form" action={mailto} method="get">
    <div class="form-field">
      <label for="name">Your name</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>

    <div class="form-field">
      <label for="business">Business name</label>
      <input id="business" name="business" type="text" required autocomplete="organization" />
    </div>

    <div class="form-field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>

    <div class="form-field">
      <label for="phone">Phone <span class="hint">(optional)</span></label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" />
    </div>

    <div class="form-field">
      <label for="package">Package interest</label>
      <select id="package" name="package">
        <option value="">Not sure yet</option>
        {PACKAGES.map((pkg) => (
          <option value={pkg.id}>{pkg.name} — {pkg.price}</option>
        ))}
      </select>
    </div>

    <div class="form-field">
      <label for="care">Care Plan interest</label>
      <select id="care" name="care">
        <option value="">None / decide later</option>
        {CARE_PLANS.map((plan) => (
          <option value={plan.id}>{plan.name} — {plan.price}/mo</option>
        ))}
      </select>
    </div>

    <div class="form-field">
      <label for="about">What do you need?</label>
      <textarea id="about" name="about" required placeholder="New site, redesign, booking/forms, or something else…"></textarea>
    </div>

    <div class="form-field">
      <label for="timeline">Ideal timeline</label>
      <select id="timeline" name="timeline">
        <option value="asap">As soon as possible</option>
        <option value="2-4-weeks" selected>2–4 weeks</option>
        <option value="1-2-months">1–2 months</option>
        <option value="exploring">Just exploring</option>
      </select>
    </div>

    <p class="form-note">
      Submitting opens your email client with a draft to <strong>{SITE_EMAIL}</strong>.
      No account required. When Formspree (or similar) is connected, this form can post
      without leaving the page — see README for the swap-in note.
    </p>

    <div class="btn-row">
      <button class="btn" type="submit">Send via email</button>
      <a class="btn btn-ghost" href={BOOKING_URL} rel="noopener noreferrer" target="_blank">Book a call instead</a>
    </div>
  </form>
</BaseLayout>

<script>
  const form = document.getElementById('intake-form') as HTMLFormElement | null;
  const params = new URLSearchParams(window.location.search);
  const pkg = params.get('package');
  const care = params.get('care');
  if (pkg) {
    const el = document.getElementById('package') as HTMLSelectElement | null;
    if (el) el.value = pkg;
  }
  if (care) {
    const el = document.getElementById('care') as HTMLSelectElement | null;
    if (el) el.value = care;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const lines = [
      'JustinCredible Web — intake',
      '',
      `Name: ${data.get('name') || ''}`,
      `Business: ${data.get('business') || ''}`,
      `Email: ${data.get('email') || ''}`,
      `Phone: ${data.get('phone') || '(not provided)'}`,
      `Package: ${data.get('package') || 'not sure'}`,
      `Care Plan: ${data.get('care') || 'none / later'}`,
      `Timeline: ${data.get('timeline') || ''}`,
      '',
      'What they need:',
      String(data.get('about') || ''),
    ];
    const body = encodeURIComponent(lines.join('\n'));
    const subject = encodeURIComponent('JustinCredible Web — intake');
    const email = 'mustangeverything@gmail.com';
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
